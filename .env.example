# ==========================================
# ENTORNO Y CONFIGURACIÓN GENERAL
# ==========================================
NODE_ENV=development
PORT=5173

# ==========================================
# URLs & APIS (Frontend Client Variables)
# ==========================================
# URL del backend al que apunta la aplicación
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_URL=http://localhost:5173

# ==========================================
# BASE DE DATOS POSTGRESQL & PRISMA
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_password
POSTGRES_DB=gestion_tareas
DATABASE_URL="postgresql://postgres:postgres_local_password@localhost:5432/gestion_tareas?schema=public"

# ==========================================
# SERVICIOS AUXILIARES (REDIS)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# AUTENTICACIÓN & SEGURIDAD
# ==========================================
VITE_AUTH_CLIENT_ID=your_client_id_here
